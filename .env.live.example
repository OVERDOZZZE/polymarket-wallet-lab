# Copy to .env.live and fill in. Never commit, share or paste this file anywhere.

# Trading wallet
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=          # your Polymarket deposit (proxy) address

# Builder program credentials (adds builder attribution headers to orders)
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Optional
# POLYMARKET_SIGNATURE_TYPE=2       # 0 = key's own address, 1 = email/Magic proxy, 2 = browser-wallet Safe
# LIVE_MAX_ORDER_USD=500            # refuse any single order above this
