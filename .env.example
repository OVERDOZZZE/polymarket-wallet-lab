# Copy to .env and fill in. Never commit .env.

# Polymarket CLOB L2 API credentials of the trading wallet (create_or_derive_api_creds).
# Optional: if missing they are derived from the private key in .env.live at startup (~0.4 s).
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# The app's database (relative paths are from the project folder)
DB_PATH=data/btc5m.db

# Server address (optional)
# HOST=127.0.0.1
# PORT=8000
